[Unit]
Description=SolomonPrime bounded-job broker connection
RequiresMountsFor=/apps/solomonprime-jobs
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=/etc/solomonprime/job-broker.env
ExecStart=/usr/local/libexec/solomon-job-broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/apps/solomonprime-jobs
InaccessiblePaths=/etc/solomonprime /var/lib/solomonprime /var/log/solomonprime /root /home
UMask=0077
TasksMax=64
MemoryMax=128M
CPUQuota=50%
TimeoutStartSec=30
TimeoutStopSec=15
RuntimeMaxSec=86600
